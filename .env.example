# Copy this file to .env (gitignored) and fill in your own Supabase
# project's values. Only needed for supabase/load_data.py -- nothing else
# in this repo uses these. Find both at https://app.supabase.com, in your
# project's Settings -> API.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
